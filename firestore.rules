rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function verifiedEmail() { return request.auth.token.email_verified == true; }
    
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'contributor';
    }
    
    function isExpert() {
      return isSignedIn() && (getUserRole() == 'expert' || getUserRole() == 'admin');
    }
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isValidArtifact(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.ownerId == request.auth.uid &&
             data.category in ['jewelry', 'weapons', 'manuscripts', 'architecture', 'food', 'clothing', 'folklore'] &&
             data.createdAt == request.time;
    }

    function isValidRecording(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.ownerId == request.auth.uid &&
             data.audioUrl is string &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /artifacts/{artifactId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.ownerId) || isExpert();
      allow create: if isSignedIn() && isValidArtifact(request.resource.data);
      allow update: if (isOwner(resource.data.ownerId) && 
                      request.resource.data.ownerId == resource.data.ownerId &&
                      request.resource.data.createdAt == resource.data.createdAt) || 
                      (isExpert() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'tags', 'materials', 'estimatedAge', 'originRegion', 'historicalContext', 'flaggedReason']));
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isExpert();
      allow update: if isOwner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId);
    }

    match /recordings/{recordingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidRecording(request.resource.data);
      allow update: if isOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /sites/{siteId} {
      allow read: if isSignedIn();
      allow write: if false; // Only admins (via backend/console) can modify sites for now
    }
  }
}
